<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <ConfigurationType>Application</ConfigurationType>
    <ProjectGuid>{D820B715-1EDD-45ED-8000-068EA989D559}</ProjectGuid>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemGroup>
    <ClCompile Include="main.c" />
    <ClCompile Include="pch.c">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="pch.h" />
  </ItemGroup>
  <ItemGroup>
    <Manifest Include="app.manifest" />
  </ItemGroup>
  <ItemGroup>
    <SampleAsset Include="assets\*.png" />
  </ItemGroup>
  <Target Name="CopySampleAssets" AfterTargets="Build"
          Inputs="@(SampleAsset)" Outputs="@(SampleAsset->'$(OutDir)assets\%(Filename)%(Extension)')">
    <Copy SourceFiles="@(SampleAsset)" DestinationFolder="$(OutDir)assets" SkipUnchangedFiles="true" />
  </Target>
  <!-- The .cso files are built by ff.base.c into a shared per-configuration directory, so they are
       copied here rather than produced here. The glob is expanded inside the target because the
       files do not exist until the referenced project has built. -->
  <Target Name="CopyShaders" AfterTargets="Build">
    <ItemGroup>
      <FfShaderBinary Include="$(FfShaderOutDir)*.cso" />
    </ItemGroup>
    <Error Condition="'@(FfShaderBinary)' == ''" Text="No compiled shaders were found in '$(FfShaderOutDir)'." />
    <Copy SourceFiles="@(FfShaderBinary)" DestinationFolder="$(OutDir)shaders" SkipUnchangedFiles="true" />
  </Target>
  <ItemGroup>
    <ProjectReference Include="..\..\source\ff.base.c\ff.base.c.vcxproj">
      <Project>{9acbc255-a76a-495d-9d2f-e6f39d8d3312}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ItemDefinitionGroup>
    <ClCompile>
      <PreprocessorDefinitions>_CONSOLE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>
</Project>